{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "review", "youtube"],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "verdict", "summary", "actions"],
      "properties": {
        "score": { "$ref": "#/$defs/score" },
        "verdict": { "type": "string", "minLength": 10 },
        "summary": { "type": "string", "minLength": 10 },
        "actions": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "youtube": { "$ref": "#/$defs/import" }
  },
  "$defs": {
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "origin": { "type": "string", "enum": ["primary", "market", "mixed"] },
    "relevance": {
      "type": "object", "additionalProperties": false, "required": ["score", "rationale"],
      "properties": { "score": { "type": "integer", "minimum": 70, "maximum": 100 }, "rationale": { "type": "string", "minLength": 20 } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["label", "url", "note"],
      "properties": { "label": { "type": "string", "minLength": 3 }, "url": { "type": "string", "format": "uri" }, "note": { "type": "string", "minLength": 8 } }
    },
    "youtubeReference": {
      "type": "object", "additionalProperties": false,
      "required": ["videoId", "title", "channel", "url", "publishedOn", "viewCount", "selectionReason"],
      "properties": {
        "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" }, "title": { "type": "string", "minLength": 5 }, "channel": { "type": "string", "minLength": 2 }, "url": { "type": "string", "format": "uri" }, "publishedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "viewCount": { "type": "integer", "minimum": 0, "maximum": 10000000000 }, "selectionReason": { "type": "string", "minLength": 18, "maxLength": 500 }
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "url", "summary", "summaryPtBr", "whyItMatters", "subject", "entity", "language", "category", "publishedAt", "observation", "sourceUrls", "reliability", "evidenceType", "relevanceScore", "noveltyScore", "urgencyScore", "opportunityScore", "confidenceScore", "factors", "aiRelevance", "sourceOrigin"],
      "properties": {
        "title": { "type": "string", "minLength": 8, "pattern": "\\b(a|as|com|como|da|das|de|do|dos|e|em|entre|na|nas|no|nos|nova|novo|o|os|para|por|que|se|sem|uma|um)\\b" }, "url": { "type": "string", "format": "uri" }, "summary": { "type": "string", "minLength": 20 }, "summaryPtBr": { "type": "string", "minLength": 20 }, "whyItMatters": { "type": "string", "minLength": 20 }, "subject": { "type": "string", "minLength": 3 }, "entity": { "type": ["string", "null"] }, "language": { "type": "string" }, "category": { "type": "string" }, "publishedAt": { "type": "string", "format": "date-time" }, "observation": { "type": "string", "minLength": 8 }, "sourceUrls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } }, "reliability": { "type": "string", "enum": ["confirmed", "rumor", "interpretation", "insufficient"] }, "evidenceType": { "type": "string", "enum": ["quantitative", "qualitative", "mixed"] }, "relevanceScore": { "$ref": "#/$defs/score" }, "noveltyScore": { "$ref": "#/$defs/score" }, "urgencyScore": { "$ref": "#/$defs/score" }, "opportunityScore": { "$ref": "#/$defs/score" }, "confidenceScore": { "$ref": "#/$defs/score" }, "factors": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["label", "score", "reason"], "properties": { "label": { "type": "string" }, "score": { "$ref": "#/$defs/score" }, "reason": { "type": "string" } } } }, "aiRelevance": { "$ref": "#/$defs/relevance" }, "sourceOrigin": { "$ref": "#/$defs/origin" }
      }
    },
    "trend": {
      "type": "object", "additionalProperties": false,
      "required": ["topicKey", "topic", "state", "score", "confidenceScore", "rationale", "evidence", "sourceUrls", "aiRelevance", "sourceOrigin"],
      "properties": { "topicKey": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "topic": { "type": "string", "minLength": 3 }, "state": { "type": "string", "enum": ["em_alta", "emergente", "estavel", "perdendo_forca", "atemporal", "desatualizado", "arquivado"] }, "score": { "$ref": "#/$defs/score" }, "confidenceScore": { "$ref": "#/$defs/score" }, "rationale": { "type": "string", "minLength": 20 }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }, "sourceUrls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } }, "aiRelevance": { "$ref": "#/$defs/relevance" }, "sourceOrigin": { "$ref": "#/$defs/origin" } }
    },
    "idea": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceFingerprint", "title", "alternateTitles", "summary", "rationale", "angle", "format", "outline", "hook", "priority", "state", "score", "confidenceScore", "evidence", "sourceUrls", "aiRelevance", "sourceOrigin", "youtubeReferences"],
      "properties": { "sourceFingerprint": { "type": "string", "minLength": 8 }, "title": { "type": "string", "minLength": 10 }, "alternateTitles": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 10 } }, "summary": { "type": "string", "minLength": 20 }, "rationale": { "type": "string", "minLength": 20 }, "angle": { "type": "string", "enum": ["explicacao", "tutorial", "demonstracao", "analise", "comparacao", "opiniao", "teste", "noticia"] }, "format": { "type": "string", "enum": ["longo", "shorts", "ambos"] }, "outline": { "type": "array", "minItems": 3, "maxItems": 8, "items": { "type": "string", "minLength": 4 } }, "hook": { "type": "string", "minLength": 10 }, "priority": { "type": "string", "enum": ["agora", "proximos_dias", "atemporal"] }, "state": { "type": "string", "enum": ["em_alta", "emergente", "estavel", "perdendo_forca", "atemporal", "desatualizado", "arquivado"] }, "score": { "$ref": "#/$defs/score" }, "confidenceScore": { "$ref": "#/$defs/score" }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }, "sourceUrls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } }, "aiRelevance": { "$ref": "#/$defs/relevance" }, "sourceOrigin": { "$ref": "#/$defs/origin" }, "youtubeReferences": { "type": ["array", "null"], "minItems": 3, "maxItems": 5, "items": { "$ref": "#/$defs/youtubeReference" } } }
    },
    "import": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "summary", "editorialProfile", "researchSourceIds", "items", "trends", "ideas"],
      "properties": { "scope": { "type": "string", "enum": ["full"] }, "summary": { "type": "string", "minLength": 20 }, "editorialProfile": { "type": ["string", "null"], "minLength": 40 }, "researchSourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } }, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }, "trends": { "type": "array", "items": { "$ref": "#/$defs/trend" } }, "ideas": { "type": "array", "items": { "$ref": "#/$defs/idea" } } }
    }
  }
}
