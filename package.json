{
  "name": "rankftv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:sandbox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-sandbox.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "eslint --config eslint.typed.config.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test lib/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:sandbox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-e2e-sandbox.ps1",
    "test:load:sandbox": "k6 run scripts/k6-sandbox-smoke.js",
    "types:supabase:generate": "node scripts/supabase-types.mjs --write",
    "types:supabase:check": "node scripts/supabase-types.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "ci:verify": "npm run audit:prod && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/qrcode": "^1.5.6",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.20.0",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.1",
    "resend": "^6.14.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
