{
  "mcpServers": {
    "postgresReadOnlyNL2SQL": {
      "command": "python",
      "args": [
        "-m",
        "mcp_servers.sql_readonly_tool"
      ],
      "security_policy": "AST validation blocking DROP, DELETE, UPDATE, INSERT, ALTER, TRUNCATE; max execution timeout 3000ms"
    },
    "erpBillingTools": {
      "command": "python",
      "args": [
        "-m",
        "mcp_servers.erp_actions_tool"
      ],
      "tools_exposed": [
        "get_invoice_details",
        "verify_contract_ceiling",
        "schedule_payment_with_human_gate"
      ]
    }
  }
}
