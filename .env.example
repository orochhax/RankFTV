NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
ADMIN_EMAIL=

# Public key only. The private Turnstile secret belongs in Supabase Auth > Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# OpenAI: geracao de roadmaps de estudo. Nunca use NEXT_PUBLIC_ na chave privada.
OPENAI_API_KEY=
OPENAI_ROADMAP_MODEL=gpt-5.6-sol
OPENAI_ROADMAP_REASONING_EFFORT=high
# Geracao normal: inclui texto visivel e raciocinio. O GPT-5.6 Sol aceita ate 128000.
OPENAI_ROADMAP_MAX_OUTPUT_TOKENS=120000
OPENAI_LIFE_OS_MODEL=gpt-5.6-luna
OPENAI_LIFE_OS_REASONING_EFFORT=low

# Asaas. Use somente o sandbox localmente e credenciais reais apenas no ambiente de producao.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Arena e beta. Mantenha 0 ate homologar separadamente cancelamento e recorrencia.
ARENA_RECURRING_PAYMENTS_ENABLED=0

# HMAC para fingerprints de IP/cartao no anti-card-testing. Gere pelo menos 32 bytes aleatorios.
PAYMENT_FINGERPRINT_SECRET=

# E-mails transacionais.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Assinatura do webhook e HMAC para pseudonimizar destinatários nos logs.
RESEND_WEBHOOK_SECRET=
EMAIL_EVENT_HASH_SECRET=

# Protege os Route Handlers chamados pelo Vercel Cron.
CRON_SECRET=

# Observabilidade HTTP generica e canal separado para alertas operacionais.
# Os payloads enviados ja passam pela camada de redacao de PII/segredos.
OBSERVABILITY_HTTP_ENDPOINT=
OBSERVABILITY_HTTP_TOKEN=
OPERATIONS_ALERT_WEBHOOK_URL=
APP_VERSION=

# E2E local/sandbox. Nunca aponte testes mutantes para a base de producao.
E2E_BASE_URL=
E2E_ATHLETE_EMAIL=
E2E_ATHLETE_PASSWORD=
E2E_ORGANIZER_EMAIL=
E2E_ORGANIZER_PASSWORD=
E2E_ASAAS_PAYMENT_ID=
E2E_ASAAS_EXTERNAL_REFERENCE=
E2E_ASAAS_MUTATION_TESTS=0
E2E_CARD_GUARD_MUTATION_TESTS=0

# Desenvolvimento local opcional. Nunca habilite em producao.
ALLOW_TUNNEL_ORIGIN=0
